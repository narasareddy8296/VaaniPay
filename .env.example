# VaaniPay Environment Configuration Template
# NOTE: Never commit production credentials. Use placeholders only.

# Application Settings
PROJECT_NAME="VaaniPay"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"
SECRET_KEY="vaanipay-development-insecure-secret-key-change-in-production"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./vaanipay.db"
# Example PostgreSQL for cloud deployment (Render/Neon/Supabase):
# DATABASE_URL="postgresql+psycopg2://user:password@hostname:5432/vaanipay"

# Security & Payment Thresholds (Central authoritative values)
MAX_VOICE_TX_AMOUNT=10000.0
MAX_DAILY_VOICE_PAYMENTS=25000.0
PIN_STEP_UP_THRESHOLD=2000.0
PIN_MAX_FAILED_ATTEMPTS=3
LIVENESS_CHALLENGE_EXPIRY_SECONDS=30
ANTISPOOF_LOW_RISK_THRESHOLD=0.30
ANTISPOOF_HIGH_RISK_THRESHOLD=0.70

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
