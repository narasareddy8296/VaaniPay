# VaaniPay Backend Environment Variables
PROJECT_NAME="VaaniPay"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Production Secret Key (Generate a random 32+ character hex string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="generate-and-set-a-random-secure-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL:
# For local evaluation: sqlite:///./vaanipay.db
# For production hosted PostgreSQL (Neon, Render, Supabase):
DATABASE_URL="postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>"

# Authoritative Security Thresholds
MAX_VOICE_TX_AMOUNT=10000.0
MAX_DAILY_VOICE_PAYMENTS=25000.0
PIN_STEP_UP_THRESHOLD=2000.0
PIN_MAX_FAILED_ATTEMPTS=3
LIVENESS_CHALLENGE_EXPIRY_SECONDS=30
ANTISPOOF_LOW_RISK_THRESHOLD=0.30
ANTISPOOF_HIGH_RISK_THRESHOLD=0.70

# CORS Allowed Origins (Set to your deployed frontend domain)
CORS_ORIGINS=["https://vaanipay-frontend.vercel.app","http://localhost:5173"]
